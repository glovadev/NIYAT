# ==============================================================================
# Nginx Configuration for NIYAT E-Commerce (Next.js on VPS)
# Path on Ubuntu VPS: /etc/nginx/sites-available/niyat.conf
# Enable via: sudo ln -s /etc/nginx/sites-available/niyat.conf /etc/nginx/sites-enabled/
# ==============================================================================

# Rate limiting zone (protects API endpoints from abuse)
limit_req_zone $binary_remote_addr zone=api_limit:10m rate=15r/s;

server {
    listen 80;
    listen [::]:80;
    server_name yourdomain.com www.yourdomain.com; # Replace with your domain or VPS IP

    # Maximum image/file upload size (covers 3-photo galleries and banners)
    client_max_body_size 25M;

    # Gzip compression for fast loading
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml application/json application/javascript application/rss+xml application/atom+xml image/svg+xml;

    # 1. Direct high-speed static delivery for uploaded images (bypasses Node.js)
    location /uploads/ {
        root /var/www/niyatuae.com/public;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000, immutable";
        access_log off;
        try_files $uri =404;
    }

    # 2. Next.js Static Assets (_next/static)
    location /_next/static/ {
        alias /var/www/niyatuae.com/.next/static/;
        expires 365d;
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
    }

    # 3. Rate-limited API routes
    location /api/ {
        limit_req zone=api_limit burst=25 nodelay;

        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 60s;
    }

    # 4. All other storefront & admin pages (Reverse proxy to Next.js Node app)
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 60s;
    }
}

